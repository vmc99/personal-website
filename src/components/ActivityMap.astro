---
// The log grid: one cell per day for the last 26 weeks, a dark cell for each published
// post (by its date). Nothing else is counted. Built at build time; a rebuild moves it on.
import type { Post } from '../lib/posts';
import { formatDate, isoDate } from '../lib/posts';

interface Props {
  posts: Post[];
  weeks?: number;
}
const { posts, weeks = 26 } = Astro.props;

const DAY = 86_400_000;
const today = new Date(isoDate(new Date()));               // midnight UTC
const mondayOffset = (today.getUTCDay() + 6) % 7;          // days since Monday
const start = new Date(today.valueOf() - (mondayOffset + (weeks - 1) * 7) * DAY);

const byDay = new Map<string, Post[]>();
for (const p of posts) {
  const k = isoDate(p.data.publishedAt);
  byDay.set(k, [...(byDay.get(k) ?? []), p]);
}

const days = Array.from({ length: weeks * 7 }, (_, i) => {
  const d = new Date(start.valueOf() + i * DAY);
  return { d, future: d > today, posts: byDay.get(isoDate(d)) ?? [] };
});
const count = days.reduce((n, x) => n + x.posts.length, 0);
---
<figure class="log">
  <div class="grid" style={`--weeks:${weeks}`}>
    {days.map(({ d, future, posts }) =>
      posts.length ? (
        <a class="cell on" href={`/blog/${posts[0].id}/`} aria-label={`${formatDate(d)}: ${posts.map((p) => p.data.title).join('; ')}`}></a>
      ) : (
        <i class:list={['cell', { future }]}></i>
      )
    )}
  </div>
  <figcaption class="meta">
    {count === 0 ? 'No posts' : count === 1 ? 'One post' : `${count} posts`} in the last {weeks} weeks.
  </figcaption>
</figure>

<style>
  .log { display: grid; gap: var(--space-2); justify-items: start; }
  .grid {
    display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column;
    grid-auto-columns: 1fr; gap: 3px; width: min(100%, calc(var(--weeks) * 15px));
  }
  .cell { aspect-ratio: 1; border-radius: 2px; background: var(--raised); display: block; }
  .cell.future { background: transparent; }
  .cell.on { background: var(--accent); }
  .cell.on:hover { background: var(--accent-hover); }
</style>

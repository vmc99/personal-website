---
// The Logbook marks, cell size 8 on a 10 grid as in the preview.
// v:      the V as five cells (portfolio). Each cell sits in its own group (.o1–.o5) so the
//         header can close it into the owl's face while the eye cells still look around.
// prompt: the same V turned on its side into a `>`, with a cursor cell (blog).
interface Props {
  kind?: 'v' | 'prompt';
  class?: string;
}
const { kind = 'v', class: cls } = Astro.props;
const V: [number, number][] = [[0, 0], [1, 1], [2, 2], [3, 1], [4, 0]];
const CHEV: [number, number][] = [[0, 0], [1, 1], [2, 2], [1, 3], [0, 4]];
---
{kind === 'v' ? (
  <svg class:list={['mk', 'mk-v', cls]} viewBox="0 0 48 28" aria-hidden="true">
    {V.map(([c, r], i) => (
      <g class={`o${i + 1}`}><rect x={c * 10} y={r * 10} width="8" height="8" rx="1.6" /></g>
    ))}
  </svg>
) : (
  <svg class:list={['mk', 'mk-prompt', cls]} viewBox="0 0 48 48" aria-hidden="true">
    <g class="chev">{CHEV.map(([c, r]) => <rect x={c * 10} y={r * 10} width="8" height="8" rx="1.6" />)}</g>
    <rect class="cur" x="40" y="40" width="8" height="8" rx="1.6" />
  </svg>
)}

<style>
  .mk { height: 20px; width: auto; flex: none; overflow: visible; display: block; }
  .mk-prompt { height: 24px; }
  rect { fill: var(--accent); }
  g, rect { transform-box: fill-box; transform-origin: center; }
</style>

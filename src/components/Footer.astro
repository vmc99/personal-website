---
// The inverse contact band at the foot of both halves, with the Twinkle strip:
// the same cells as the hero, much quieter. Now and then one cell warms and fades back.
// Nothing follows the pointer. Static under reduced motion. See DESIGN.md.
import { site, social } from '../site';
---
<footer class="site-foot flip" id="contact">
  <div class="wrap foot-in">
    <div class="foot-text">
      <h2 class="foot-title">Say hello back.</h2>
      <p class="foot-links">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span aria-hidden="true">·</span> <a href="/static/resume.pdf">Résumé</a>
        {social.map((s) => <><span aria-hidden="true">·</span> <a href={s.href} rel="me">{s.label}</a></>)}
      </p>
      <p class="foot-small">© {new Date().getFullYear()} {site.author} · <a href="/privacy-policy/">Privacy</a> · <a href="/blog/rss.xml">RSS</a></p>
    </div>
    <div class="ff" aria-hidden="true"></div>
  </div>
</footer>

<script>
  import { reduceMotion } from '../scripts/presence';

  const ff = document.querySelector<HTMLElement>('.ff');
  let tick = 0;

  function build() {
    if (!ff) return;
    clearInterval(tick);
    const wide = innerWidth >= 900;
    const W = document.documentElement.clientWidth;
    const room = wide ? W - ff.getBoundingClientRect().left : W;
    const pitch = wide ? 30 : 24;
    const gap = Math.max(3, Math.round(pitch * 0.15));
    const rows = wide ? 7 : 5;
    const cols = Math.ceil(room / pitch) + (wide ? 1 : 2);
    ff.style.cssText = `--cell:${pitch - gap}px;--gap:${gap}px;--cols:${cols};--fy:${pitch}px`;
    ff.replaceChildren(...Array.from({ length: cols * rows }, () => document.createElement('i')));
    if (reduceMotion) return;
    const kids = ff.children;
    tick = window.setInterval(() => {
      if (document.hidden) return;
      const k = kids[Math.floor(Math.random() * kids.length)];
      if (k.className) return;
      k.className = 'tw';
      setTimeout(() => (k.className = ''), 1700);
    }, 650);
  }

  build();
  let rz = 0;
  addEventListener('resize', () => {
    clearTimeout(rz);
    rz = window.setTimeout(build, 150);
  });
</script>

<style>
  .site-foot { background: var(--ground); color: var(--ink); margin-top: var(--space-7); overflow: clip; }
  .foot-in {
    padding-block: var(--space-6); display: grid; gap: var(--space-5) var(--space-6);
    grid-template-columns: minmax(0, 1fr); align-items: center;
  }
  @media (min-width: 900px) { .foot-in { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); } }
  .foot-text { display: grid; gap: var(--space-4); }
  .foot-title { font: 400 var(--step-head)/1.02 var(--font-serif); letter-spacing: -0.02em; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0 0.5em; }
  .site-foot a { color: var(--ink); }
  .site-foot a:hover { color: var(--accent); }
  .foot-small { font-size: var(--step-small); color: var(--muted); }
  .foot-small a { color: inherit; }

  /* The strip bleeds off the right edge and fades out on all four sides. */
  .ff {
    --fl: 14%; --fr: 14%; --fy: 24px;
    display: grid; grid-template-columns: repeat(var(--cols, 12), var(--cell, 20px));
    grid-auto-rows: var(--cell, 20px); gap: var(--gap, 4px);
    justify-content: center; margin-inline: calc(-1 * var(--gutter));
    mask-image:
      linear-gradient(to right, transparent, #000 var(--fl), #000 calc(100% - var(--fr)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fy), #000 calc(100% - var(--fy)), transparent);
    mask-composite: intersect;
  }
  @media (min-width: 900px) {
    .ff {
      --fl: 18%; --fr: 6%; justify-content: start; margin-left: 0;
      margin-right: calc(-1 * (var(--gutter) + max(0px, (100vw - var(--page)) / 2)));
    }
  }
  .ff :global(i) { display: block; border-radius: var(--radius); background: var(--raised); }
  .ff :global(i.tw) { background: var(--t1); }
  @media (prefers-reduced-motion: no-preference) {
    .ff :global(i) { transition: background-color 1.6s ease-in-out; }
  }
</style>

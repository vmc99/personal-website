---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../site';
// Only the two first-paint faces are preloaded: the serif roman and the sans, Latin subset.
import serifUrl from '@fontsource-variable/newsreader/files/newsreader-latin-opsz-normal.woff2?url';
import sansUrl from '@fontsource-variable/hanken-grotesk/files/hanken-grotesk-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  half: 'portfolio' | 'blog';
  type?: 'website' | 'article';
  image?: string;
}
const { title, description, half, type = 'website', image } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
// Every page has a share image: its own, or its half's default.
const ogImage = new URL(image ?? (half === 'blog' ? '/og/blog.png' : '/og/home.png'), site.url).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Apply a stored Light/Dark choice before first paint. System needs no script. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
      try {
        const root = document.documentElement, blog = location.pathname.startsWith('/blog/');
        // The intro plays once per session on each half, never under reduced motion.
        const key = blog ? 'intro-blog' : 'intro-portfolio';
        if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem(key)) {
          sessionStorage.setItem(key, '1');
          root.classList.add('intro-pending');
        }
        // The blog's prompt mark turns only on the first blog page of the session.
        if (blog) {
          if (sessionStorage.getItem('mark-turned')) root.classList.add('mark-settled');
          else sessionStorage.setItem('mark-turned', '1');
        }
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.blog.name} href="/blog/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={half === 'blog' ? site.blog.name : site.author} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body data-half={half}>
    <a class="skip" href="#main">Skip to content</a>
    <Header half={half} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Intro />
  </body>
</html>

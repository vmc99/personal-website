---
// Case study. Order from DESIGN.md: problem, constraints, contribution, system design,
// evidence, lessons, links. Only public facts are written; the rest is a marked placeholder
// until Vamsi supplies it. Never invent metrics or screenshots.
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import '../../styles/prose.css';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const d = project.data;
---
<Base title={`${d.title} · Vamsi Mukkamala`} description={d.summary} half="portfolio">
  <article class="case">
    <div class="wrap"><header class={`field f-${d.field} case-head`}>
      <p class="meta"><a href="/#work">Selected work</a> · {d.context} · {d.year}</p>
      <h1 style={`view-transition-name: work-${project.id}`}>{d.title}</h1>
      <p class="case-sum">{d.summary}</p>
      {d.award && <p class="meta"><a href={d.award.url}>{d.award.label}</a></p>}
    </header></div>

    <div class="case-body">
      <dl class="facts">
        <div><dt>Stack</dt><dd>{d.stack.join(', ')}</dd></div>
        <div><dt>Code</dt><dd><a href={d.repo}>Repository on GitHub</a></dd></div>
      </dl>

      <div class="prose case-prose">
        <Content />
        <h2>My contribution</h2>
        {d.contribution
          ? <p>{d.contribution}</p>
          : <p><Placeholder note={`${d.title}: personal contribution, metrics that can be stated, public screenshots or diagrams`}>Personal contribution, evidence and lessons to come.</Placeholder></p>}
      </div>
    </div>
  </article>
</Base>

<style>
  .case { padding-top: var(--space-5); }
  .case-head { gap: var(--space-3); padding-block: clamp(40px, 6vw, 80px); }
  .case-head .meta a { color: inherit; }
  .case-head h1 { font: 400 var(--step-display)/0.98 var(--font-serif); letter-spacing: -0.03em; text-wrap: balance; }
  .case-sum { font-size: var(--step-lead); line-height: 1.35; max-width: 40ch; }
  .case-body {
    max-width: calc(var(--column) + 2 * var(--gutter)); margin: var(--space-6) auto 0;
    padding-inline: var(--gutter); display: grid; gap: var(--space-5);
  }
  .facts { display: grid; gap: var(--space-2); margin: 0; font-size: var(--step-small); }
  .facts div { display: grid; grid-template-columns: 5rem 1fr; gap: var(--space-3); }
  .facts dt { color: var(--muted); }
  .facts dd { margin: 0; }
  .case-prose :global(h2:first-child) { margin-top: 0; }
</style>
